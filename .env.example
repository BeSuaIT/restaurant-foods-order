# ===== Server =====
NODE_ENV=production
PORT=3000

# ===== Database (PostgreSQL) =====
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=ttth_order
DB_USER=ttth
DB_PASSWORD=ttth_password_change_me

# ===== Auth =====
# ĐỔI CHUỖI NÀY trước khi chạy production
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=12h

# ===== Web =====
# Địa chỉ public để dựng mã QR trỏ về đúng (vd: http://100.100.1.5)
PUBLIC_URL=http://100.100.1.5

# Thư mục lưu ảnh món ăn
UPLOAD_DIR=./uploads

# Thư mục chứa bản build frontend (Express phục vụ luôn)
WEB_DIST_DIR=./web/dist

# Đường dẫn file schema dùng cho `npm run db:migrate`
SCHEMA_PATH=./sql/schema.sql
